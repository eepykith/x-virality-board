weet_ids":["2114814823066398856"],"id":"2114814823066398856","in_reply_to_user_id":"15958614","public_metrics":{"bookmark_count":4,"impression_count":23626,"like_count":152,"quote_count":0,"reply_count":1,"retweet_count":3},"referenced_tweets":[{"id":"2114813933622321251","type":"replied_to"}],"text":"It’s still even listed as a feature. https://t.co/cT4zpSueUN","url":"https://x.com/i/status/2114814823066398856"},{"created_at":"2026-10-26T20:18:27.000Z","edit_history_tweet_ids":["2114813933622321251"],"id":"2114813933622321251","public_metrics":{"bookmark_count":74,"impression_count":200276,"like_count":1317,"quote_count":4,"reply_count":45,"retweet_count":24},"text":"I have no idea why this is the case but the iPhone Duo seems like it’s missing FaceTime Picture in Picture.  A wild omission given the bigger screen.","url":"https://x.com/i/status/2114813933622321251"},{"attachments":{"media_keys":["3_2114778433813413888"]},"created_at":"2026-10-26T17:57:24.000Z","edit_history_tweet_ids":["2114778437227548954"],"id":"2114778437227548954","public_metrics":{"bookmark_count":64,"impression_count":104773,"like_count":1788,"quote_count":9,"reply_count":53,"retweet_count":41},"text":"Apple has been touting this new Zoom app for the iPhone Duo since September but it doesn’t even exist yet. https://t.co/vxTseMLh10","url":"https://x.com/i/status/2114778437227548954"},{"created_at":"2026-10-26T17:45:44.000Z","edit_history_tweet_ids":["2114775498379460838"],"id":"2114775498379460838","public_metrics":{"bookmark_count":91,"impression_count":175427,"like_count":1102,"quote_count":1,"reply_count":55,"retweet_count":18},"referenced_tweets":[{"id":"2111821318660448707","type":"quoted"}],"text":"Guess who wasn't so crazy to say Apple pulled the trigger early? https://t.co/jNsssRwjdV","url":"https://x.com/i/status/2114775498379460838"},{"created_at":"2026-10-26T17:07:52.000Z","edit_history_tweet_ids":["2114765970380304387"],"id":"2114765970380304387","public_metrics":{"bookmark_count":